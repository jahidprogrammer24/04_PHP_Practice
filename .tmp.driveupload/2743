<?php
/*
  INTERFACE (PHP) 11

  What is it?
  - An interface is a template for classes, just like a class is a
    template for objects.
  - It only has method names, parameters and return types.
    The methods have no body (no code inside).
  - It works like a contract: any class that uses the interface must
    have all of its methods.
  - We write it with the `interface` keyword:
        interface MyInterface {
            public function myFunction(int $a, int $b);
        }

  How to use it:
  - A class uses an interface with the `implements` keyword
    (not `extends`):
        class MyClass implements MyInterface { ... }
  - The class must implement every method of the interface.
    This means it must write the real code for each method.

  Rules:
  1. Interface methods have no body, so there are no curly braces { }.
  2. All interface methods must be public.
  3. In the class, each method must match the interface exactly:
     same name, same number of parameters, same types and same
     return type.
  4. If the class misses even one method, PHP shows a Fatal error.
  5. You cannot make an object from an interface directly.
*/
//Example 
interface Speak
{
  //public $name;//Fatal error: Interfaces may not include properties

  public function talk();
  //public function see();


  //public function talk($arg);//Fatal error: Declaration of Dog::talk() must be compatible with Speak::talk($arg)

  // public function talk()
  // {
  //Fatal error: Interface function Speak::talk() cannot contain body
  // }

  //private function talk();//Fatal error: Access type for interface method Speak::talk() must be public

}
//class Dog extends Speak//Fatal error: Class Dog cannot extend interface Speak

class Dog implements Speak
{
  public function talk()
  {
    echo "Woof!";
  }
  //Fatal error: Class Dog contains 1 abstract method and must therefore be declared abstract or implement the remaining methods (Speak::see)
}
class Cat implements Speak
{
  public function talk()
  {
    echo "Meow";
  }
  //Fatal error: Class Cat contains 1 abstract method and must therefore be declared abstract or implement the remaining methods (Speak::see)

  // public function talk()
  // {
  //   echo "Meow";
  // }
}

$dog = new Dog();
$cat = new Cat();
$dog->talk();
$cat->talk(); //Fatal error: Class Cat contains 1 abstract method and must therefore be declared abstract or implement the remaining methods (Speak::talk)

//implement two interface. 
interface Speak1
{
  public function talk();
}
interface Walk
{
  public function walk();
}

class Robot implements Speak1, Walk
{
  public function talk()
  {
    echo "Hello, I am a robot" . "<br>";
  }
  public function walk()
  {
    echo "Robot is walking" . "<br>";
  }
}
$robot = new Robot();
$robot->talk(); //Hello, I am a robot
$robot->walk(); //Robot is walking

